<article class="card card-interactive flex-row items-stretch gap-4 p-4 sm:p-5">
    <a href="novel/@Novel.Id" class="w-24 shrink-0 sm:w-28" tabindex="-1" aria-hidden="true">
        <NovelCover Novel="Novel" />
    </a>

    <div class="flex min-w-0 flex-1 flex-col gap-3">
        <div class="flex flex-col gap-1">
            <div class="flex flex-wrap items-center gap-2">
                <StatusBadge Status="Novel.Status" />
                <span class="kicker">@Novel.SourceSite</span>
            </div>
            <a href="novel/@Novel.Id" class="mt-1 line-clamp-2 text-base font-semibold leading-snug text-ink hover:underline">
                @Novel.Title
            </a>
            @if (!string.IsNullOrWhiteSpace(Novel.Author))
            {
                <span class="truncate text-sm text-ink-muted">by @Novel.Author</span>
            }
        </div>

        <div class="mt-auto flex flex-col gap-1.5">
            <div class="flex items-baseline justify-between font-mono text-xs text-ink-secondary">
                <span>Ch. @Novel.CurrentChapter@(Novel.TotalChapters is { } t ? $" / {t}" : "")</span>
                @if (Novel.Progress is { } p)
                {
                    <span>@((int)Math.Round(p * 100))%</span>
                }
            </div>
            <div class="h-1.5 overflow-hidden rounded-full border border-line-subtle bg-void"
                 role="progressbar" aria-label="Reading progress"
                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)Math.Round((Novel.Progress ?? 0) * 100))">
                <div class="h-full rounded-full bg-linear-to-r from-ink-secondary to-ink transition-[width] duration-300"
                     style="width: @(((Novel.Progress ?? 0) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <a href="@Novel.ContinueUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary min-h-8 px-3 text-xs">
                @(Novel.CurrentChapter == 0 ? "Start reading" : "Continue") ↗
            </a>
            <button type="button" class="btn btn-matte min-h-8 px-3 text-xs" title="Mark next chapter as read"
                    disabled="@(Novel.TotalChapters is { } total && Novel.CurrentChapter >= total)"
                    @onclick="() => Library.BumpChapterAsync(Novel.Id)">
                +1 ch
            </button>
        </div>
    </div>
</article>

@code {
    [Inject] private LibraryService Library { get; set; } = default!;

    [Parameter, EditorRequired] public Novel Novel { get; set; } = default!;
}
