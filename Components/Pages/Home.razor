@page "/"
@rendermode InteractiveServer

<PageTitle>Sample Website</PageTitle>

<!-- HERO SECTION -->
<section id="home" class="section">
    <div class="container-page flex flex-col gap-8">
        <div class="flex flex-wrap items-center gap-3">
            <span class="badge">
                <span class="size-[0.45rem] rounded-full bg-emerald shadow-[0_0_8px_var(--color-emerald)]"></span>
                <span>Matte Black Template</span>
            </span>
            <span class="badge">Blazor + Tailwind CSS</span>
        </div>

        <div class="flex max-w-3xl flex-col gap-4">
            <h1 class="hero-title">A Clean Matte Black Website Template.</h1>
            <p class="max-w-2xl text-lg">
                Simple, dark aesthetic layout built with C# Blazor and Tailwind CSS. Replace the text and cards below whenever you have your project idea ready.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <a href="#features" class="btn btn-primary">Explore Layout</a>
            <button type="button" class="btn btn-matte" @onclick="IncrementClicks">
                Test Button (@ClickCount)
            </button>
        </div>
    </div>
</section>

<!-- BENTO GRID / FEATURES SECTION -->
<section id="features" class="section">
    <div class="container-page flex flex-col gap-8">
        <div class="flex flex-col gap-2">
            <span class="kicker">LAYOUT</span>
            <h2 class="text-[clamp(1.5rem,2.5vw,2.1rem)]">Sample Sections &amp; Cards</h2>
        </div>

        <div class="grid grid-cols-1 gap-5 lg:grid-cols-12">
            <article class="card card-interactive lg:col-span-8">
                <div class="flex flex-col gap-2">
                    <span class="kicker">MAIN FEATURE</span>
                    <h3 class="mt-1.5 text-[1.4rem]">Your Main Idea Goes Here</h3>
                    <p>Use this wide card to highlight the main feature of your website, a dashboard preview, or an introduction to your project.</p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <span class="badge">Tailwind CSS</span>
                    <span class="badge">Responsive Grid</span>
                </div>
            </article>

            <article class="card card-interactive lg:col-span-4">
                <div class="flex flex-col gap-2">
                    <span class="kicker">HIGHLIGHT</span>
                    <h3 class="mt-1.5 text-xl">Side Card</h3>
                    <p>Great for stats, profile info, or quick links.</p>
                </div>
                <div class="text-[clamp(1.75rem,2.5vw,2.35rem)] font-semibold tracking-[-0.04em] tabular-nums">100%</div>
            </article>

            @foreach (var (kicker, title, body) in Cards)
            {
                <article class="card card-interactive lg:col-span-4">
                    <div class="flex flex-col gap-2">
                        <span class="kicker">@kicker</span>
                        <h3 class="mt-1.5 text-xl">@title</h3>
                        <p>@body</p>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<!-- SIMPLE FORM / INTERACTIVE SECTION -->
<section id="contact" class="py-12 sm:py-18">
    <div class="container-page">
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
            <div class="card">
                <div class="flex flex-col gap-2">
                    <span class="kicker">SAMPLE FORM</span>
                    <h3 class="mt-1.5 text-xl">Add an Item / Note</h3>
                    <p>Try adding a sample item to test the form input and list.</p>
                </div>

                <div class="flex flex-col gap-4">
                    <div class="flex flex-col gap-2">
                        <label class="field-label" for="item-input">Title</label>
                        <input id="item-input" class="input" placeholder="Type something..."
                               @bind="NewItem" @bind:event="oninput" />
                    </div>
                    <div>
                        <button type="button" class="btn btn-primary" @onclick="AddItem">Add to List</button>
                    </div>
                </div>
            </div>

            <div class="card justify-start">
                <div class="flex flex-col gap-2">
                    <span class="kicker">SAMPLE LIST (@Items.Count)</span>
                    <h3 class="mt-1.5 text-xl">Saved Items</h3>
                </div>

                <div class="flex flex-col gap-2">
                    @foreach (var item in Items)
                    {
                        <div class="flex items-center justify-between rounded-sm border border-line-subtle bg-void px-3.5 py-3 transition hover:border-line">
                            <span class="text-ink">@item</span>
                            <button type="button" class="btn btn-ghost" @onclick="() => RemoveItem(item)">Remove</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly (string Kicker, string Title, string Body)[] Cards =
    [
        ("CARD 01", "Matte Surface", "Clean dark cards with subtle borders and smooth hover lift."),
        ("CARD 02", "Tailwind Utilities", "Styled with Tailwind CSS utility classes and a small set of theme tokens."),
        ("CARD 03", "C# Powered", "Ready for Blazor buttons, forms, and pages whenever you need them.")
    ];

    private int ClickCount = 0;
    private string NewItem = "";

    private List<string> Items =
    [
        "First sample item",
        "Second sample item",
        "Third sample item"
    ];

    private void IncrementClicks()
    {
        ClickCount++;
    }

    private void AddItem()
    {
        if (!string.IsNullOrWhiteSpace(NewItem))
        {
            Items.Add(NewItem.Trim());
            NewItem = "";
        }
    }

    private void RemoveItem(string item)
    {
        Items.Remove(item);
    }
}
