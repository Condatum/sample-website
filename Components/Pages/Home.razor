@page "/"
@implements IDisposable
@inject LibraryService Library

<PageTitle>Library · NovelShelf</PageTitle>

<section class="section">
    <div class="container-page flex flex-col gap-8">
        <div class="flex flex-col gap-3">
            <span class="kicker">YOUR LIBRARY</span>
            <h1 class="hero-title">Every novel, one shelf.</h1>
            <p class="max-w-2xl text-lg">
                Web novels and light novels from any site, gathered in one place. Track your chapter, then jump straight back in.
            </p>
        </div>

        @if (loaded)
        {
            <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                @foreach (var (label, value) in Stats)
                {
                    <div class="rounded-md border border-line bg-matte px-4 py-3">
                        <dt class="kicker">@label</dt>
                        <dd class="mt-1 text-2xl font-semibold tracking-tight tabular-nums">@value</dd>
                    </div>
                }
            </dl>
        }
    </div>
</section>

<section class="py-10 sm:py-14">
    <div class="container-page flex flex-col gap-6">
        @if (!loaded)
        {
            <p class="kicker">Loading your shelf…</p>
        }
        else
        {
            <!-- Toolbar -->
            <div class="flex flex-col gap-4">
                <div class="flex flex-col gap-3 sm:flex-row">
                    <label class="sr-only" for="search">Search</label>
                    <input id="search" type="search" class="input sm:flex-1" placeholder="Search by title, author, tag or site…"
                           @bind="search" @bind:event="oninput" />
                    <div class="flex gap-3">
                        <label class="sr-only" for="kind">Type</label>
                        <select id="kind" class="input w-auto" @bind="kindFilter">
                            <option value="">All types</option>
                            @foreach (var kind in Enum.GetValues<NovelKind>())
                            {
                                <option value="@kind">@kind.DisplayName()</option>
                            }
                        </select>
                        <label class="sr-only" for="sort">Sort by</label>
                        <select id="sort" class="input w-auto" @bind="sort">
                            <option value="@SortOrder.Recent">Recently updated</option>
                            <option value="@SortOrder.Title">Title A–Z</option>
                            <option value="@SortOrder.Progress">Progress</option>
                            <option value="@SortOrder.Added">Recently added</option>
                        </select>
                    </div>
                </div>

                <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filter by status">
                    <button type="button" role="tab" aria-selected="@(statusFilter is null)"
                            class="nav-link border border-line-subtle @(statusFilter is null ? "active" : "")"
                            @onclick="() => statusFilter = null">
                        All <span class="ml-1 font-mono text-ink-muted">@Library.Novels.Count</span>
                    </button>
                    @foreach (var status in Enum.GetValues<ReadingStatus>())
                    {
                        <button type="button" role="tab" aria-selected="@(statusFilter == status)"
                                class="nav-link border border-line-subtle @(statusFilter == status ? "active" : "")"
                                @onclick="() => statusFilter = status">
                            @status.DisplayName() <span class="ml-1 font-mono text-ink-muted">@Library.Novels.Count(n => n.Status == status)</span>
                        </button>
                    }
                </div>
            </div>

            @if (Library.Novels.Count == 0)
            {
                <div class="card items-start justify-start">
                    <span class="kicker">EMPTY SHELF</span>
                    <h2 class="text-xl">Your library is empty.</h2>
                    <p>Add your first web novel or light novel from any site, or load a few examples to explore.</p>
                    <div class="flex flex-wrap gap-3">
                        <a href="add" class="btn btn-primary">+ Add Novel</a>
                        <button type="button" class="btn btn-matte" @onclick="Library.ResetToSamplesAsync">Load examples</button>
                    </div>
                </div>
            }
            else if (Visible.Count == 0)
            {
                <div class="card items-start justify-start">
                    <h2 class="text-xl">No matches.</h2>
                    <p>Nothing on your shelf matches these filters.</p>
                    <button type="button" class="btn btn-matte" @onclick="ClearFilters">Clear filters</button>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
                    @foreach (var novel in Visible)
                    {
                        <NovelCard @key="novel.Id" Novel="novel" />
                    }
                </div>
            }
        }
    </div>
</section>

@code {
    private enum SortOrder { Recent, Title, Progress, Added }

    private bool loaded;
    private string search = "";
    private string kindFilter = "";
    private SortOrder sort = SortOrder.Recent;
    private ReadingStatus? statusFilter;

    protected override async Task OnInitializedAsync()
    {
        Library.Changed += OnLibraryChanged;
        await Library.EnsureLoadedAsync();
        loaded = true;
    }

    private IEnumerable<(string Label, string Value)> Stats =>
    [
        ("NOVELS", Library.Novels.Count.ToString()),
        ("READING", Library.Novels.Count(n => n.Status == ReadingStatus.Reading).ToString()),
        ("COMPLETED", Library.Novels.Count(n => n.Status == ReadingStatus.Completed).ToString()),
        ("CHAPTERS READ", Library.Novels.Sum(n => n.CurrentChapter).ToString("N0"))
    ];

    private List<Novel> Visible
    {
        get
        {
            IEnumerable<Novel> query = Library.Novels;

            if (statusFilter is { } status)
                query = query.Where(n => n.Status == status);

            if (Enum.TryParse<NovelKind>(kindFilter, out var kind))
                query = query.Where(n => n.Kind == kind);

            if (!string.IsNullOrWhiteSpace(search))
            {
                var term = search.Trim();
                query = query.Where(n =>
                    n.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (n.Author?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    n.SourceSite.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    n.Tags.Any(t => t.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            query = sort switch
            {
                SortOrder.Title => query.OrderBy(n => n.Title, StringComparer.OrdinalIgnoreCase),
                SortOrder.Progress => query.OrderByDescending(n => n.Progress ?? -1),
                SortOrder.Added => query.OrderByDescending(n => n.AddedAt),
                _ => query.OrderByDescending(n => n.UpdatedAt)
            };

            return query.ToList();
        }
    }

    private void ClearFilters()
    {
        search = "";
        kindFilter = "";
        statusFilter = null;
    }

    private void OnLibraryChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Library.Changed -= OnLibraryChanged;
}
