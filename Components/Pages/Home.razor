@page "/"
@rendermode InteractiveServer

<PageTitle>Sample Website</PageTitle>

<!-- HERO SECTION -->
<section id="home" class="section">
    <div class="container stack-lg">
        <div class="flex-row">
            <span class="badge">
                <span class="status-dot online"></span>
                <span>Matte Black Template</span>
            </span>
            <span class="badge">Blazor + Pure CSS</span>
        </div>

        <div class="stack-md" style="max-inline-size: 48rem;">
            <h1 class="hero-title">
                A Clean Matte Black Website Template.
            </h1>
            <p style="font-size: 1.125rem; max-inline-size: 40rem;">
                Simple, dark aesthetic layout built with C# Blazor and pure CSS. Replace the text and cards below whenever you have your project idea ready.
            </p>
        </div>

        <div class="flex-row">
            <a href="#features" class="btn btn-primary">Explore Layout</a>
            <button type="button" class="btn btn-matte" @onclick="IncrementClicks">
                Test Button (@ClickCount)
            </button>
        </div>
    </div>
</section>

<!-- BENTO GRID / FEATURES SECTION -->
<section id="features" class="section">
    <div class="container stack-lg">
        <div class="stack-sm">
            <span class="card-kicker">LAYOUT</span>
            <h2 class="section-title">Sample Sections &amp; Cards</h2>
        </div>

        <div class="bento-grid">
            <article class="matte-card interactive col-span-8">
                <div class="stack-sm">
                    <span class="card-kicker">MAIN FEATURE</span>
                    <h3 class="card-title" style="font-size: 1.4rem;">Your Main Idea Goes Here</h3>
                    <p>Use this wide card to highlight the main feature of your website, a dashboard preview, or an introduction to your project.</p>
                </div>
                <div class="flex-row">
                    <span class="badge">Pure CSS</span>
                    <span class="badge">Responsive Grid</span>
                </div>
            </article>

            <article class="matte-card interactive col-span-4">
                <div class="stack-sm">
                    <span class="card-kicker">HIGHLIGHT</span>
                    <h3 class="card-title">Side Card</h3>
                    <p>Great for stats, profile info, or quick links.</p>
                </div>
                <div class="metric-value">100%</div>
            </article>

            <article id="cards" class="matte-card interactive col-span-4">
                <div class="stack-sm">
                    <span class="card-kicker">CARD 01</span>
                    <h3 class="card-title">Matte Surface</h3>
                    <p>Clean dark cards with subtle borders and smooth hover lift.</p>
                </div>
            </article>

            <article class="matte-card interactive col-span-4">
                <div class="stack-sm">
                    <span class="card-kicker">CARD 02</span>
                    <h3 class="card-title">Pure CSS Only</h3>
                    <p>No Bootstrap or Tailwind. Everything lives in a single clean stylesheet.</p>
                </div>
            </article>

            <article class="matte-card interactive col-span-4">
                <div class="stack-sm">
                    <span class="card-kicker">CARD 03</span>
                    <h3 class="card-title">C# Powered</h3>
                    <p>Ready for Blazor buttons, forms, and pages whenever you need them.</p>
                </div>
            </article>
        </div>
    </div>
</section>

<!-- SIMPLE FORM / INTERACTIVE SECTION -->
<section id="contact" class="section" style="border-block-end: none;">
    <div class="container stack-lg">
        <div class="bento-grid">
            <div class="matte-card col-span-6">
                <div class="stack-sm">
                    <span class="card-kicker">SAMPLE FORM</span>
                    <h3 class="card-title">Add an Item / Note</h3>
                    <p>Try adding a sample item to test the form input and list.</p>
                </div>

                <div class="stack-md">
                    <div class="field-group">
                        <label class="field-label" for="item-input">Title</label>
                        <input id="item-input"
                               class="input-matte"
                               placeholder="Type something..."
                               @bind="NewItem"
                               @bind:event="oninput" />
                    </div>

                    <div>
                        <button type="button" class="btn btn-primary" @onclick="AddItem">
                            Add to List
                        </button>
                    </div>
                </div>
            </div>

            <div class="matte-card col-span-6">
                <div class="stack-sm">
                    <span class="card-kicker">SAMPLE LIST (@Items.Count)</span>
                    <h3 class="card-title">Saved Items</h3>
                </div>

                <div class="stack-sm">
                    @foreach (var item in Items)
                    {
                        <div class="toggle-row">
                            <span class="text-primary">@item</span>
                            <button type="button" class="btn btn-ghost" @onclick="() => RemoveItem(item)">Remove</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private int ClickCount = 0;
    private string NewItem = "";

    private List<string> Items =
    [
        "First sample item",
        "Second sample item",
        "Third sample item"
    ];

    private void IncrementClicks()
    {
        ClickCount++;
    }

    private void AddItem()
    {
        if (!string.IsNullOrWhiteSpace(NewItem))
        {
            Items.Add(NewItem.Trim());
            NewItem = "";
        }
    }

    private void RemoveItem(string item)
    {
        Items.Remove(item);
    }
}
