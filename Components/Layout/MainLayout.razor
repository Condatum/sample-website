@inherits LayoutComponentBase

<div class="app-shell">
    <header class="topbar">
        <div class="topbar-inner">
            <a href="" class="brand">
                <span class="brand-mark" aria-hidden="true"></span>
                <span>SAMPLE WEBSITE</span>
            </a>

            <nav class="nav-links" aria-label="Main Navigation">
                <a href="#home" class="nav-item active">Home</a>
                <a href="#features" class="nav-item">Features</a>
                <a href="#cards" class="nav-item">Cards</a>
                <a href="#contact" class="nav-item">Contact</a>
            </nav>

            <div class="flex-row">
                <a href="#contact" class="btn btn-primary">Get Started</a>
            </div>
        </div>
    </header>

    <main style="flex: 1;">
        @Body
    </main>

    <footer style="padding-block: 2.5rem; border-block-start: 1px solid var(--border-subtle);">
        <div class="container flex-between" style="flex-wrap: wrap;">
            <div class="flex-row">
                <span class="brand-mark" aria-hidden="true"></span>
                <span class="text-secondary">Sample Website</span>
            </div>
            <div class="text-muted">
                <span>Built with C# Blazor &amp; Pure CSS</span>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
