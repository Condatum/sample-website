@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-50 border-b border-line-subtle bg-void/80 backdrop-blur-lg">
        <div class="container-page flex h-16 items-center justify-between gap-6">
            <a href="" class="inline-flex items-center gap-2.5 text-[0.95rem] font-semibold tracking-tight">
                <BrandMark />
                <span>NOVELSHELF</span>
            </a>

            <nav class="hidden items-center gap-1 rounded-full border border-line-subtle bg-matte p-1 md:flex" aria-label="Main Navigation">
                @foreach (var link in Links)
                {
                    <NavLink href="@link.Href" class="nav-link" Match="@link.Match">@link.Label</NavLink>
                }
            </nav>

            <div class="flex items-center gap-2">
                <a href="add" class="btn btn-primary hidden sm:inline-flex">+ Add Novel</a>
                <button type="button" class="btn btn-matte px-3 md:hidden" aria-label="Toggle menu"
                        aria-expanded="@(menuOpen ? "true" : "false")" aria-controls="mobile-menu" @onclick="ToggleMenu">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        @if (menuOpen)
                        {
                            <path d="M6 6l12 12M18 6L6 18" />
                        }
                        else
                        {
                            <path d="M4 7h16M4 12h16M4 17h16" />
                        }
                    </svg>
                </button>
            </div>
        </div>

        @if (menuOpen)
        {
            <nav id="mobile-menu" class="border-t border-line-subtle md:hidden" aria-label="Mobile Navigation">
                <div class="container-page flex flex-col gap-1 py-3">
                    @foreach (var link in Links)
                    {
                        <NavLink href="@link.Href" class="mobile-link" Match="@link.Match">@link.Label</NavLink>
                    }
                    <a href="add" class="btn btn-primary mt-2 sm:hidden">+ Add Novel</a>
                </div>
            </nav>
        }
    </header>

    <main class="flex-1">
        @Body
    </main>

    <footer class="border-t border-line-subtle py-10">
        <div class="container-page flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <BrandMark />
                <span class="text-ink-secondary">NovelShelf</span>
            </div>
            <span class="text-ink-muted">Built with C# Blazor &amp; Tailwind CSS</span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload underline">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private record NavItem(string Href, string Label, NavLinkMatch Match = NavLinkMatch.Prefix);

    private static readonly NavItem[] Links =
    [
        new("", "Library", NavLinkMatch.All),
        new("about", "About")
    ];

    private bool menuOpen;

    protected override void OnInitialized() => Navigation.LocationChanged += CloseMenu;

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void CloseMenu(object? sender, LocationChangedEventArgs e)
    {
        if (!menuOpen) return;
        menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= CloseMenu;
}
